#include <iostream>

using namespace std;

int main() {
    int N;
    double suma = 0.0;

    do {
        cout << "Ingrese un numero entero positivo N: ";
        cin >> N;
    } while (N <= 0);

    for (int i = 1; i <= N; i++) {
        suma += 1.0 / i;
    }

    cout << "La suma de la serie S es: " << suma << endl;

    return 0;
}
