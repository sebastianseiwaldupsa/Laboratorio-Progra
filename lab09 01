
#include <iostream>
using namespace std;

const int MAX_ELEMENTOS = 100;

int leerCantidad();
void registrarNotas(int notas[], int n);
void calcularResultados(const int notas[], int n);
void mostrarNotas(const int notas[], int n);

int main() {
    int notas[MAX_ELEMENTOS];

    int n = leerCantidad();

    registrarNotas(notas, n);

    mostrarNotas(notas, n);

    calcularResultados(notas, n);

    return 0;
}

int leerCantidad() {
    int n;

    do {
        cout << "Ingrese la cantidad de estudiantes: ";
        cin >> n;

        if (n >= 1 && n <= MAX_ELEMENTOS) {
            return n;
        } else {
            cout << "Cantidad invalida. Intente nuevamente." << endl;
        }

    } while (true);
}

void registrarNotas(int notas[], int n) {
    for (int i = 0; i < n; i++) {
        do {
            cout << "Nota estudiante " << i + 1 << ": ";
            cin >> notas[i];

            if (notas[i] >= 0 && notas[i] <= 100) {
                break;
            } else {
                cout << "Nota invalida. Ingrese entre 0 y 100." << endl;
            }

        } while (true);
    }
}

void mostrarNotas(const int notas[], int n) {
    cout << endl;
    cout << "NOTAS REGISTRADAS" << endl;

    for (int i = 0; i < n; i++) {
        cout << notas[i] << "  ";
    }

    cout << endl;
}

void calcularResultados(const int notas[], int n) {
    int suma = 0;
    int mayor = notas[0];
    int menor = notas[0];
    double promedio;

    for (int i = 0; i < n; i++) {
        suma += notas[i];

        if (notas[i] > mayor) {
            mayor = notas[i];
        }

        if (notas[i] < menor) {
            menor = notas[i];
        }
    }

    promedio = (double)suma / n;

    cout << "Promedio general: " << promedio << endl;
    cout << "Nota mayor: " << mayor << endl;
    cout << "Nota menor: " << menor << endl;
}
