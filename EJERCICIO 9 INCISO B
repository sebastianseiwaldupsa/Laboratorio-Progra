}

// EJERCICIO 9
void corregirNombre(string nombres[], int habitaciones[], int n) {

    int habitacion, opcion;
    string buscar, reemplazar;

    cout << "Ingrese habitacion: ";
    cin >> habitacion;

    int pos = buscarReserva(habitaciones, n, habitacion);

    if (pos != -1) {

        cout << "Nombre actual: " << nombres[pos] << endl;

        cout << "1. Reemplazar una parte" << endl;
        cout << "2. Agregar prefijo Sr-" << endl;
        cout << "3. Quitar prefijo Sr-" << endl;

        cout << "Elija una opcion: ";
        cin >> opcion;

        if (opcion == 1) {

            cout << "Parte que desea cambiar: ";
            cin >> buscar;

            cout << "Nuevo texto: ";
            cin >> reemplazar;

            int lugar = nombres[pos].find(buscar);

            if (lugar != string::npos) {

                nombres[pos].replace(lugar, buscar.length(), reemplazar);

                cout << "Nombre corregido: " << nombres[pos] << endl;

            }
            else {
                cout << "Texto no encontrado" << endl;
            }

        }
        else if (opcion == 2) {

            if (nombres[pos].find("Sr-") != 0) {

                nombres[pos].insert(0, "Sr-");

                cout << "Nuevo nombre: " << nombres[pos] << endl;

            }
            else {
                cout << "El prefijo ya existe" << endl;
            }

        }
        else if (opcion == 3) {

            if (nombres[pos].find("Sr-") == 0) {

                nombres[pos].erase(0, 3);

                cout << "Nuevo nombre: " << nombres[pos] << endl;

            }
            else {
                cout << "No tiene prefijo" << endl;
            }

        }
        else {
            cout << "Opcion incorrecta" << endl;
        }

    }
    else {
        cout << "Reserva no encontrada" << endl;
    }

}

// EJERCICIO 10
void mostrarResumen(string nombres[], string apellidos[], int habitaciones[], int noches[], int n) {

    int totalNoches = 0;
    int mayor = 0;

    if (n > 0) {

        for (int i = 0; i < n; i++) {

            totalNoches = totalNoches + noches[i];

            if (noches[i] > noches[mayor]) {
                mayor = i;
            }

        }

        cout << "Total de reservas: " << n << endl;
        cout << "Total de noches: " << totalNoches << endl;

        cout << "Reserva de mayor duracion: " << endl;
        cout << nombres[mayor] << " " << apellidos[mayor] << endl;
        cout << "Habitacion: " << habitaciones[mayor] << endl;
        cout << "Noches: " << noches[mayor] << endl;

    }
    else {
        cout << "No hay reservas registradas" << endl;
    }

}
