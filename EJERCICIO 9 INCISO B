    }

}

// BUSCAR RESERVA
int buscarReserva(int habitaciones[], int n, int habitacion) {

    int posicion = -1;

    for (int i = 0; i < n; i++) {

        if (habitaciones[i] == habitacion) {
            posicion = i;
        }

    }

    return posicion;

}

// EJERCICIO 4
void actualizarNoches(string nombres[], string apellidos[], int habitaciones[], int noches[], int n) {

    int habitacion, nuevas;
    string nombre, apellido;

    cout << "Ingrese habitacion: ";
    cin >> habitacion;

    int pos = buscarReserva(habitaciones, n, habitacion);

    if (pos != -1) {

        cout << "Ingrese nombre: ";
        cin >> nombre;

        cout << "Ingrese apellido: ";
        cin >> apellido;

        if (nombres[pos].compare(nombre) == 0 &&
            apellidos[pos].compare(apellido) == 0) {

            cout << "Noches anteriores: " << noches[pos] << endl;

            cout << "Ingrese nuevas noches: ";
            cin >> nuevas;

            if (nuevas > 0) {

                noches[pos] = nuevas;

                cout << "Noches actualizadas: " << noches[pos] << endl;

            }
            else {
                cout << "Cantidad incorrecta" << endl;
            }

        }
        else {
            cout << "Nombre o apellido incorrecto" << endl;
        }

    }
    else {
        cout << "Reserva no encontrada" << endl;
    }

}

// EJERCICIO 5
void reducirNoches(int habitaciones[], int noches[], int n) {

    int habitacion, reducir;

    cout << "Ingrese habitacion: ";
    cin >> habitacion;

    int pos = buscarReserva(habitaciones, n, habitacion);

    if (pos != -1) {

        cout << "Noches actuales: " << noches[pos] << endl;

        cout << "Cuantas noches desea reducir: ";
        cin >> reducir;

        if (reducir > 0 && reducir < noches[pos]) {

            noches[pos] = noches[pos] - reducir;

            cout << "Nuevas noches: " << noches[pos] << endl;

        }
        else {
            cout << "Reduccion incorrecta" << endl;
        }

    }
    else {
        cout << "Reserva no encontrada" << endl;
    }

}

// EJERCICIO 6
void ampliarReserva(string nombres[], int habitaciones[], int noches[], int n) {

    string nombre;
    int habitacion, ampliar;
    int pos = -1;

    cout << "Ingrese nombre del huesped: ";
    cin >> nombre;

    cout << "Ingrese habitacion: ";
    cin >> habitacion;

    for (int i = 0; i < n; i++) {

        if (nombres[i].find(nombre) != string::npos &&
            habitaciones[i] == habitacion) {

            pos = i;
        }

    }

    if (pos != -1) {

        cout << "Noches actuales: " << noches[pos] << endl;

        cout << "Cuantas noches desea ampliar: ";
        cin >> ampliar;

        if (ampliar > 0) {

            noches[pos] = noches[pos] + ampliar;

            cout << "Nuevas noches: " << noches[pos] << endl;

        }
        else {
            cout << "Cantidad incorrecta" << endl;
        }

    }
    else {
        cout << "Reserva no encontrada" << endl;
    }

}

// EJERCICIO 7
void generarCodigos(string nombres[], string apellidos[], int habitaciones[], int n) {

    for (int i = 0; i < n; i++) {

        if (nombres[i].length() >= 3 && apellidos[i].length() >= 3) {

            string codigo = nombres[i].substr(0, 3) +
                            apellidos[i].substr(0, 3) +
                            to_string(habitaciones[i]);

            cout << nombres[i] << " ";
            cout << "Codigo: " << codigo << endl;

        }

    }

}

