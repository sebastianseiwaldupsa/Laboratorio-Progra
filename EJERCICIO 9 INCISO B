
#include <iostream>
#include <string>
using namespace std;

// PROTOTIPOS
void registrarReserva(string nombres[], string apellidos[], int habitaciones[], int noches[], int &n);
void registrarVarias(string nombres[], string apellidos[], int habitaciones[], int noches[], int &n);
void mostrarReservas(string nombres[], string apellidos[], int habitaciones[], int noches[], int n);
void buscarHuespedes(string nombres[], string apellidos[], int habitaciones[], int noches[], int n);
int buscarReserva(int habitaciones[], int n, int habitacion);
void actualizarNoches(string nombres[], string apellidos[], int habitaciones[], int noches[], int n);
void reducirNoches(int habitaciones[], int noches[], int n);
void ampliarReserva(string nombres[], int habitaciones[], int noches[], int n);
void generarCodigos(string nombres[], string apellidos[], int habitaciones[], int n);
void buscarPorApellido(string nombres[], string apellidos[], int habitaciones[], int noches[], int n);
void corregirNombre(string nombres[], int habitaciones[], int n);
void mostrarResumen(string nombres[], string apellidos[], int habitaciones[], int noches[], int n);

int main() {

    string nombres[20];
    string apellidos[20];
    int habitaciones[20];
    int noches[20];

    int n = 0;
    int opcion;

    do {

        cout << endl;
        cout << "===== HOTEL =====" << endl;
        cout << "1. Registrar una reserva" << endl;
        cout << "2. Registrar varias reservas" << endl;
        cout << "3. Mostrar reservas" << endl;
        cout << "4. Buscar huespedes" << endl;
        cout << "5. Actualizar noches" << endl;
        cout << "6. Salida anticipada" << endl;
        cout << "7. Ampliar reserva" << endl;
        cout << "8. Generar codigos" << endl;
        cout << "9. Buscar por apellido" << endl;
        cout << "10. Corregir nombre" << endl;
        cout << "11. Mostrar resumen" << endl;
        cout << "12. Salir" << endl;

        cout << "Elija una opcion: ";
        cin >> opcion;

        if (opcion == 1) {
            registrarReserva(nombres, apellidos, habitaciones, noches, n);
        }
        else if (opcion == 2) {
            registrarVarias(nombres, apellidos, habitaciones, noches, n);
        }
        else if (opcion == 3) {
            mostrarReservas(nombres, apellidos, habitaciones, noches, n);
        }
        else if (opcion == 4) {
            buscarHuespedes(nombres, apellidos, habitaciones, noches, n);
        }
        else if (opcion == 5) {
            actualizarNoches(nombres, apellidos, habitaciones, noches, n);
        }
        else if (opcion == 6) {
            reducirNoches(habitaciones, noches, n);
        }
        else if (opcion == 7) {
            ampliarReserva(nombres, habitaciones, noches, n);
        }
        else if (opcion == 8) {
            generarCodigos(nombres, apellidos, habitaciones, n);
        }
        else if (opcion == 9) {
            buscarPorApellido(nombres, apellidos, habitaciones, noches, n);
        }
        else if (opcion == 10) {
            corregirNombre(nombres, habitaciones, n);
        }
        else if (opcion == 11) {
            mostrarResumen(nombres, apellidos, habitaciones, noches, n);
        }
        else if (opcion == 12) {
            cout << "Programa finalizado" << endl;
        }
        else {
            cout << "Opcion incorrecta" << endl;
        }

    } while (opcion != 12);

    return 0;
}

// EJERCICIO 1
void registrarReserva(string nombres[], string apellidos[], int habitaciones[], int noches[], int &n) {

    string nombre, apellido;
    int habitacion, noche;
    int repetida = 0;

    if (n < 20) {

        cout << "Ingrese nombre: ";
        cin >> nombre;

        cout << "Ingrese apellido: ";
        cin >> apellido;

        cout << "Ingrese habitacion: ";
        cin >> habitacion;

        cout << "Ingrese noches: ";
        cin >> noche;

        if (nombre.empty() || apellido.empty() ||
            nombre.length() < 3 || apellido.length() < 3 ||
            habitacion <= 0 || noche <= 0) {

            cout << "Datos incorrectos" << endl;

        }
        else {

            for (int i = 0; i < n; i++) {
                if (habitaciones[i] == habitacion) {
                    repetida = 1;
                }
            }

            if (repetida == 0) {

                nombres[n] = nombre;
                apellidos[n] = apellido;
                habitaciones[n] = habitacion;
                noches[n] = noche;

                n++;

                cout << "Reserva registrada correctamente" << endl;

            }
            else {
                cout << "Habitacion ocupada" << endl;
            }
        }

    }
    else {
        cout << "Hotel lleno" << endl;
    }
}

// EJERCICIO 2
void registrarVarias(string nombres[], string apellidos[], int habitaciones[], int noches[], int &n) {

    int cantidad;

    cout << "Cuantas reservas desea registrar: ";
    cin >> cantidad;

    if (cantidad > 0 && cantidad <= 20 - n) {

        for (int i = 0; i < cantidad; i++) {

            cout << endl;
            cout << "Reserva numero " << i + 1 << endl;

            registrarReserva(nombres, apellidos, habitaciones, noches, n);

        }

    }
    else {
        cout << "Cantidad incorrecta o no hay espacio" << endl;
    }

}

// MOSTRAR RESERVAS
void mostrarReservas(string nombres[], string apellidos[], int habitaciones[], int noches[], int n) {

    if (n == 0) {
        cout << "No hay reservas" << endl;
    }

    for (int i = 0; i < n; i++) {

        cout << endl;
        cout << "Nombre: " << nombres[i] << endl;
        cout << "Apellido: " << apellidos[i] << endl;
        cout << "Habitacion: " << habitaciones[i] << endl;
        cout << "Noches: " << noches[i] << endl;

    }

}

// EJERCICIO 3
void buscarHuespedes(string nombres[], string apellidos[], int habitaciones[], int noches[], int n) {

    string buscar;
    int encontrado = 0;

    cout << "Ingrese parte del nombre: ";
    cin >> buscar;

    for (int i = 0; i < n; i++) {

        if (nombres[i].find(buscar) != string::npos) {

            cout << nombres[i] << " ";
